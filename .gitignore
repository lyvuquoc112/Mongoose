# =============================================================================
# .gitignore for Mongoose & MongoDB (Node.js) Projects
# =============================================================================

# Dependencies
node_modules/
.npm/
.pnpm-store/
.pnp
.pnp.*

# Environment Variables, Connection URIs & TLS Certificates
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template
*.pem
*.key
*.crt
*.ca
*.p12
secrets.json
credentials.json

# Local MongoDB Dumps, Backups & Data Files
dump/
*.bson
*.wt
WiredTiger*
mongod.lock
diagnostic.data/

# Build & TypeScript Outputs
dist/
build/
*.tsbuildinfo
.eslintcache

# Logs, Runtime & Testing
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids/
*.pid
*.seed
*.pid.lock
coverage/
.nyc_output/
tmp/
temp/

# IDEs & Editors
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
!**/.vscode/*.code-snippets
.idea/
*.iml
*.sw?

# Operating System
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*~
